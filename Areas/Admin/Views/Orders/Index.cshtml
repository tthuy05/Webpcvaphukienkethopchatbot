@using Webpcvaphukienkethopchatbot.Models.Enums
@model IReadOnlyList<Webpcvaphukienkethopchatbot.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn";
}

<partial name="_AdminNav" />

<header class="page-header">
    <div>
        <p class="page-kicker">Vận hành bán hàng</p>
        <h1 class="page-title">Đơn hàng</h1>
        <p class="page-subtitle">Theo dõi khách hàng, giá trị và trạng thái xử lý của từng đơn.</p>
    </div>
</header>

<form method="get" class="toolbar-card" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="order-search">Mã đơn hoặc người nhận</label>
            <input id="order-search"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Nhập mã đơn hoặc tên người nhận" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="order-status-filter">Trạng thái</label>
            <select id="order-status-filter" name="status" class="form-select">
                <option value="">Mọi trạng thái</option>
                @foreach (var value in Enum.GetValues<OrderStatus>())
                {
                    <option value="@value" selected="@(ViewBag.Status?.ToString() == value.ToString())">@value</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" type="submit">Lọc đơn hàng</button>
        </div>
    </div>
</form>

<section class="surface-card" aria-labelledby="orders-table-title">
    <div class="surface-card-header">
        <div>
            <h2 class="h5 mb-1" id="orders-table-title">Danh sách đơn hàng</h2>
            <p class="text-muted small mb-0">Kết quả theo bộ lọc tìm kiếm và trạng thái hiện tại.</p>
        </div>
    </div>
    <div class="surface-card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <h3 class="h6">Không có đơn hàng phù hợp</h3>
                <p class="text-muted mb-0">Thử điều chỉnh nội dung tìm kiếm hoặc trạng thái lọc.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle data-table mb-0">
                    <caption class="visually-hidden">Danh sách đơn hàng</caption>
                    <thead>
                        <tr>
                            <th scope="col">Mã</th>
                            <th scope="col">Khách hàng</th>
                            <th scope="col">Ngày</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col" class="text-end">Tổng</th>
                            <th scope="col" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.Status switch
                        {
                            OrderStatus.Pending => "status-warning",
                            OrderStatus.Confirmed => "status-info",
                            OrderStatus.Shipping => "status-info",
                            OrderStatus.Completed => "status-success",
                            OrderStatus.Cancelled => "status-danger",
                            _ => "status-muted"
                        };

                        <tr>
                            <td class="fw-semibold text-nowrap">@item.OrderNumber</td>
                            <td>
                                <div class="text-break">@item.ApplicationUser?.Email</div>
                                <div class="small text-muted">@item.ReceiverName</div>
                            </td>
                            <td class="text-nowrap">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="status-badge @statusClass">@item.Status</span></td>
                            <td class="text-end text-nowrap">@item.TotalAmount.ToString("N0")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   aria-label="Xem chi tiết đơn @item.OrderNumber">Chi tiết</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
