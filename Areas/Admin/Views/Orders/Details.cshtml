@model Webpcvaphukienkethopchatbot.ViewModels.AdminOrderDetailViewModel

@{
    ViewData["Title"] = Model.OrderNumber;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Don hang @Model.OrderNumber</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Danh sach don hang</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="border rounded p-3">
            <h2 class="h5">Khach hang</h2>
            <div>@Model.CustomerEmail</div>
            <div>@Model.ReceiverName</div>
            <div>@Model.PhoneNumber</div>
            <div>@Model.ShippingAddress</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="border rounded p-3">
            <h2 class="h5">Cap nhat trang thai</h2>
            <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="status" class="form-select">
                    @foreach (var status in Model.StatusOptions)
                    {
                        <option value="@status" selected="@(status == Model.Status)">@status</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">Luu</button>
            </form>
            <div class="mt-3 small">Thanh toan: @Model.PaymentStatus - @Model.PaymentMethod</div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>San pham</th>
                <th class="text-end">Don gia</th>
                <th class="text-end">So luong</th>
                <th class="text-end">Thanh tien</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td class="text-end">@item.UnitPrice.ToString("N0")</td>
                <td class="text-end">@item.Quantity</td>
                <td class="text-end">@item.LineTotal.ToString("N0")</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Tong tien</th>
                <th class="text-end">@Model.TotalAmount.ToString("N0")</th>
            </tr>
        </tfoot>
    </table>
</div>
