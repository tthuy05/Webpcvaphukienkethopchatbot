@model IReadOnlyList<Webpcvaphukienkethopchatbot.Models.AuditLog>

@{
    ViewData["Title"] = "Nhật ký audit";
}

<partial name="_AdminNav" />

<header class="page-header">
    <div>
        <p class="page-kicker">Hệ thống</p>
        <h1 class="page-title">Nhật ký audit</h1>
        <p class="page-subtitle">Theo dõi các thao tác quản trị và kết quả xử lý trong hệ thống.</p>
    </div>
</header>

<section class="surface-card" aria-labelledby="audit-table-title">
    <div class="surface-card-header">
        <div>
            <h2 class="h5 mb-1" id="audit-table-title">Lịch sử thao tác</h2>
            <p class="text-muted small mb-0">Các bản ghi audit mới nhất được lưu bởi hệ thống.</p>
        </div>
    </div>
    <div class="surface-card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <h3 class="h6">Chưa có bản ghi audit</h3>
                <p class="text-muted mb-0">Các thao tác quản trị sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle data-table mb-0">
                    <caption class="visually-hidden">Danh sách nhật ký audit</caption>
                    <thead>
                        <tr>
                            <th scope="col">Thời gian</th>
                            <th scope="col">Hành động</th>
                            <th scope="col">Người dùng</th>
                            <th scope="col">Đối tượng</th>
                            <th scope="col">IP</th>
                            <th scope="col">Kết quả</th>
                            <th scope="col">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@item.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
                            <td>@item.Action</td>
                            <td class="small text-break">@item.ApplicationUserId</td>
                            <td>@item.EntityType #@item.EntityId</td>
                            <td class="text-nowrap">@item.IpAddress</td>
                            <td>
                                <span class="status-badge @(item.Succeeded ? "status-success" : "status-danger")">
                                    @(item.Succeeded ? "Thành công" : "Lỗi")
                                </span>
                            </td>
                            <td class="text-break">@item.Details</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
