@model IReadOnlyList<Webpcvaphukienkethopchatbot.Models.Coupon>

@{
    ViewData["Title"] = "Mã giảm giá";
}

<partial name="_AdminNav" />

<header class="page-header">
    <div>
        <p class="page-kicker">Khuyến mãi</p>
        <h1 class="page-title">Mã giảm giá</h1>
        <p class="page-subtitle">Quản lý giá trị, giới hạn sử dụng và trạng thái của từng mã.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Edit">Thêm mã giảm giá</a>
    </div>
</header>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<section class="surface-card" aria-labelledby="coupons-table-title">
    <div class="surface-card-header">
        <div>
            <h2 class="h5 mb-1" id="coupons-table-title">Danh sách mã giảm giá</h2>
            <p class="text-muted small mb-0">Thông tin sử dụng và trạng thái hiệu lực hiện tại.</p>
        </div>
    </div>
    <div class="surface-card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <h3 class="h6">Chưa có mã giảm giá</h3>
                <p class="text-muted mb-0">Các mã giảm giá đã tạo sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle data-table mb-0">
                    <caption class="visually-hidden">Danh sách mã giảm giá</caption>
                    <thead>
                        <tr>
                            <th scope="col">Mã</th>
                            <th scope="col">Giá trị</th>
                            <th scope="col">Đơn tối thiểu</th>
                            <th scope="col">Đã dùng / Giới hạn</th>
                            <th scope="col">Hiệu lực</th>
                            <th scope="col" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Code</strong>
                                <div class="small text-muted">@item.Description</div>
                            </td>
                            <td class="text-nowrap">
                                @item.Value.ToString("N0") @(item.DiscountType.ToString() == "Percentage" ? "%" : "₫")
                            </td>
                            <td class="text-nowrap">@item.MinimumOrderAmount.ToString("N0")</td>
                            <td>@item.UsedCount / @(item.UsageLimit?.ToString() ?? "∞")</td>
                            <td>
                                <span class="status-badge @(item.IsActive ? "status-success" : "status-muted")">
                                    @(item.IsActive ? "Đang bật" : "Đã tắt")
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   aria-label="Sửa mã giảm giá @item.Code">Sửa</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
