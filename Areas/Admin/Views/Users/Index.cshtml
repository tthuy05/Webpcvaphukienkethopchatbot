@model IReadOnlyList<Webpcvaphukienkethopchatbot.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<partial name="_AdminNav" />

<header class="page-header">
    <div>
        <p class="page-kicker">Tài khoản và phân quyền</p>
        <h1 class="page-title">Quản lý người dùng</h1>
        <p class="page-subtitle">Theo dõi vai trò, trạng thái và quyền truy cập của tài khoản.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">Về trang chủ</a>
    </div>
</header>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<section class="surface-card" aria-labelledby="users-table-title">
    <div class="surface-card-header">
        <div>
            <h2 class="h5 mb-1" id="users-table-title">Danh sách người dùng</h2>
            <p class="text-muted small mb-0">Vai trò và trạng thái đăng nhập hiện tại của từng tài khoản.</p>
        </div>
    </div>
    <div class="surface-card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <h3 class="h6">Chưa có người dùng</h3>
                <p class="text-muted mb-0">Tài khoản được tạo sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle data-table mb-0">
                    <caption class="visually-hidden">Danh sách người dùng và phân quyền</caption>
                    <thead>
                        <tr>
                            <th scope="col">Email</th>
                            <th scope="col">Họ tên</th>
                            <th scope="col">Vai trò</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="text-break fw-semibold">@user.Email</td>
                            <td>@user.FullName</td>
                            <td>@user.Roles</td>
                            <td>
                                <span class="status-badge @(user.IsLocked ? "status-danger" : "status-success")">
                                    @(user.IsLocked ? "Bị khóa" : "Đang hoạt động")
                                </span>
                            </td>
                            <td class="text-end">
                                <form asp-action="SetRole"
                                      method="post"
                                      class="d-inline-flex gap-1 mb-1"
                                      aria-label="Cập nhật vai trò cho @user.Email">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <select name="role"
                                            class="form-select form-select-sm"
                                            aria-label="Vai trò của @user.Email">
                                        <option value="User" selected="@user.Roles.Contains("User")">User</option>
                                        <option value="Admin" selected="@user.Roles.Contains("Admin")">Admin</option>
                                    </select>
                                    <button class="btn btn-sm btn-outline-primary" type="submit">Cập nhật vai trò</button>
                                </form>
                                <form asp-action="ToggleLock"
                                      method="post"
                                      class="d-inline"
                                      aria-label="@(user.IsLocked ? $"Mở khóa {user.Email}" : $"Khóa {user.Email}")">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit"
                                            class="btn btn-sm @(user.IsLocked ? "btn-outline-success" : "btn-outline-danger")">
                                        @(user.IsLocked ? "Mở khóa" : "Khóa")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
