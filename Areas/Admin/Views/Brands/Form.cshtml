@model Webpcvaphukienkethopchatbot.ViewModels.CatalogFormViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Create brand" : "Edit brand";
}

<h1 class="h3 mb-3">@(Model.Id == 0 ? "Them thuong hieu" : "Sua thuong hieu")</h1>

<form asp-action="Save" method="post" class="border rounded p-3">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Ten</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Mo ta</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Hien thi</label>
    </div>
    <button type="submit" class="btn btn-primary">Luu</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Huy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
