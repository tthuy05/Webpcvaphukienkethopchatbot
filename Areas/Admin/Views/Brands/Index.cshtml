@model IReadOnlyList<Webpcvaphukienkethopchatbot.ViewModels.CatalogItemViewModel>

@{
    ViewData["Title"] = "Brands";
}

<section class="page-heading">
    <div>
        <nav class="breadcrumb-line" aria-label="breadcrumb">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>Thương hiệu</span>
        </nav>
        <div class="section-kicker">Brand taxonomy</div>
        <h1 class="hero-title hero-title--page">Thương hiệu</h1>
        <p class="hero-copy">Quản lý thương hiệu hiển thị trong catalog, form sản phẩm và bộ lọc.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <span class="material-symbols-outlined align-middle me-1">add</span>
        Thêm thương hiệu
    </a>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<section class="data-panel">
    <div class="data-panel__header">
        <div>
            <div class="section-kicker">Danh sách</div>
            <h2 class="h4 fw-bold mb-0">@Model.Count thương hiệu</h2>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="material-symbols-outlined empty-icon">sell</span>
            <h3 class="h5 fw-bold mb-0">Chưa có thương hiệu</h3>
            <p class="muted-text mb-0">Tạo thương hiệu trước khi thêm sản phẩm mới.</p>
            <a class="btn btn-primary" asp-action="Create">Thêm thương hiệu</a>
        </div>
    }
    else
    {
        <div class="table-shell">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tên</th>
                        <th>Slug</th>
                        <th class="text-end">Sản phẩm</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td><code>@item.Slug</code></td>
                        <td class="text-end">@item.ProductCount</td>
                        <td><span class="state-badge @(item.IsActive ? "state-badge--success" : "state-badge--neutral")">@(item.IsActive ? "Đang hiển thị" : "Đang ẩn")</span></td>
                        <td class="text-end">
                            <div class="action-cluster">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                <form asp-action="Delete" method="post" class="inline-action-form">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Ẩn hoặc xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
