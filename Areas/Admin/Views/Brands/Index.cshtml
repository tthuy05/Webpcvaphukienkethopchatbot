@model IReadOnlyList<Webpcvaphukienkethopchatbot.Models.Brand>

@{
    ViewData["Title"] = "Thương hiệu";
}

<partial name="_AdminNav" />

<header class="page-header">
    <div>
        <p class="page-kicker">Danh mục sản phẩm</p>
        <h1 class="page-title">Thương hiệu</h1>
        <p class="page-subtitle">Quản lý các thương hiệu được sử dụng trong danh mục sản phẩm.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Edit">Thêm thương hiệu</a>
    </div>
</header>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<section class="surface-card" aria-labelledby="brands-table-title">
    <div class="surface-card-header">
        <div>
            <h2 class="h5 mb-1" id="brands-table-title">Danh sách thương hiệu</h2>
            <p class="text-muted small mb-0">Tên, đường dẫn và trạng thái hiển thị hiện tại.</p>
        </div>
    </div>
    <div class="surface-card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <h3 class="h6">Chưa có thương hiệu</h3>
                <p class="text-muted mb-0">Thêm thương hiệu đầu tiên để phân loại sản phẩm.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle data-table mb-0">
                    <caption class="visually-hidden">Danh sách thương hiệu</caption>
                    <thead>
                        <tr>
                            <th scope="col">Tên</th>
                            <th scope="col">Slug</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td><code>@item.Slug</code></td>
                            <td>
                                <span class="status-badge @(item.IsActive ? "status-success" : "status-muted")">
                                    @(item.IsActive ? "Hoạt động" : "Đã ẩn")
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   aria-label="Sửa thương hiệu @item.Name">Sửa</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
