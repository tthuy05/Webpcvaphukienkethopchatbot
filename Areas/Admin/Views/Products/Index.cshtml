@model IReadOnlyList<Webpcvaphukienkethopchatbot.ViewModels.AdminProductItemViewModel>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">San pham</h1>
    <a class="btn btn-primary" asp-action="Create">Them san pham</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Anh</th>
                <th>Ten</th>
                <th>Hang</th>
                <th>Danh muc</th>
                <th class="text-end">Gia</th>
                <th class="text-end">Ton kho</th>
                <th>Trang thai</th>
                <th class="text-end">Thao tac</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td><img src="@product.MainImageUrl" alt="@product.Name" width="72" height="48" class="object-fit-contain border rounded" /></td>
                <td>@product.Name</td>
                <td>@product.BrandName</td>
                <td>@product.CategoryName</td>
                <td class="text-end">@product.Price.ToString("N0")</td>
                <td class="text-end">@product.StockQuantity</td>
                <td><span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">@(product.IsActive ? "Hien" : "An")</span></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Sua</a>
                    <form asp-action="Hide" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@product.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">An</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
