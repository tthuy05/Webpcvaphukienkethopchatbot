@model IReadOnlyList<Webpcvaphukienkethopchatbot.ViewModels.AdminProductItemViewModel>

@{
    ViewData["Title"] = "Products";
}

<section class="page-heading">
    <div>
        <nav class="breadcrumb-line" aria-label="breadcrumb">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>Sản phẩm</span>
        </nav>
        <div class="section-kicker">Catalog management</div>
        <h1 class="hero-title hero-title--page">Quản lý sản phẩm</h1>
        <p class="hero-copy">Thêm, chỉnh sửa, ẩn hoặc hiển thị lại sản phẩm trong catalog người dùng.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <span class="material-symbols-outlined align-middle me-1">add</span>
        Thêm sản phẩm
    </a>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<section class="data-panel">
    <div class="data-panel__header">
        <div>
            <div class="section-kicker">Danh sách</div>
            <h2 class="h4 fw-bold mb-0">@Model.Count sản phẩm</h2>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="material-symbols-outlined empty-icon">inventory_2</span>
            <h3 class="h5 fw-bold mb-0">Chưa có sản phẩm</h3>
            <p class="muted-text mb-0">Tạo sản phẩm đầu tiên để catalog, chatbot và trang chủ có dữ liệu hiển thị.</p>
            <a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a>
        </div>
    }
    else
    {
        <div class="table-shell">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Hãng</th>
                        <th>Danh mục</th>
                        <th class="text-end">Giá</th>
                        <th class="text-end">Tồn kho</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <div class="table-product">
                                <img src="@product.MainImageUrl" alt="@product.Name" />
                                <strong>@product.Name</strong>
                            </div>
                        </td>
                        <td>@product.BrandName</td>
                        <td>@product.CategoryName</td>
                        <td class="text-end fw-bold">@product.Price.ToString("N0")</td>
                        <td class="text-end">@product.StockQuantity</td>
                        <td><span class="state-badge @(product.IsActive ? "state-badge--success" : "state-badge--neutral")">@(product.IsActive ? "Đang hiển thị" : "Đang ẩn")</span></td>
                        <td class="text-end">
                            <div class="action-cluster">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Sửa</a>
                                <form asp-action="SetActive" method="post" class="inline-action-form">
                                    <input type="hidden" name="id" value="@product.Id" />
                                    <input type="hidden" name="isActive" value="@(!product.IsActive)" />
                                    <button type="submit" class="btn btn-sm @(product.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(product.IsActive ? "Ẩn" : "Hiển thị")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
