@model Webpcvaphukienkethopchatbot.ViewModels.ProductFormViewModel

@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Create product" : "Edit product";
}

<section class="page-heading">
    <div>
        <nav class="breadcrumb-line" aria-label="breadcrumb">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <a asp-action="Index">Sản phẩm</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>@(isNew ? "Thêm mới" : "Chỉnh sửa")</span>
        </nav>
        <div class="section-kicker">Product form</div>
        <h1 class="hero-title hero-title--page">@(isNew ? "Thêm sản phẩm" : "Sửa sản phẩm")</h1>
        <p class="hero-copy">Cập nhật thông tin giá, tồn kho, cấu hình và ảnh đại diện cho catalog.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <span class="material-symbols-outlined align-middle me-1">arrow_back</span>
        Danh sách
    </a>
</section>

<form asp-action="Save" method="post" enctype="multipart/form-data" class="form-card">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImageUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="form-section-title">
        <span class="material-symbols-outlined">inventory_2</span>
        <span>Thông tin bán hàng</span>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <label asp-for="Name" class="form-label">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Price" class="form-label">Giá</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="StockQuantity" class="form-label">Tồn kho</label>
            <input asp-for="StockQuantity" class="form-control" />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CategoryId" class="form-label">Danh mục</label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BrandId" class="form-label">Thương hiệu</label>
            <select asp-for="BrandId" asp-items="Model.Brands" class="form-select"></select>
            <span asp-validation-for="BrandId" class="text-danger"></span>
        </div>
    </div>

    <div class="form-section-title">
        <span class="material-symbols-outlined">developer_board</span>
        <span>Cấu hình</span>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4"><label asp-for="Cpu" class="form-label">CPU</label><input asp-for="Cpu" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Ram" class="form-label">RAM</label><input asp-for="Ram" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Ssd" class="form-label">SSD</label><input asp-for="Ssd" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Gpu" class="form-label">GPU</label><input asp-for="Gpu" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Screen" class="form-label">Màn hình</label><input asp-for="Screen" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Battery" class="form-label">Pin</label><input asp-for="Battery" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Weight" class="form-label">Trọng lượng</label><input asp-for="Weight" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="OperatingSystem" class="form-label">Hệ điều hành</label><input asp-for="OperatingSystem" class="form-control" /></div>
        <div class="col-md-4">
            <label asp-for="SuitableNeeds" class="form-label">Nhu cầu phù hợp</label>
            <input asp-for="SuitableNeeds" class="form-control" />
            <span asp-validation-for="SuitableNeeds" class="text-danger"></span>
        </div>
    </div>

    <div class="form-section-title">
        <span class="material-symbols-outlined">image</span>
        <span>Nội dung & hiển thị</span>
    </div>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="ImageFile" class="form-label">Ảnh sản phẩm</label>
            <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
            <div class="form-text muted-text">Hỗ trợ JPG, PNG, WEBP, GIF. Tối đa 5MB theo cấu hình controller.</div>
        </div>
        <div class="col-md-4">
            @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
            {
                <img src="@Model.ExistingImageUrl" alt="@Model.Name" class="img-fluid border rounded p-2" />
            }
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Hiển thị sản phẩm trong catalog</label>
            </div>
        </div>
    </div>

    <div class="button-row">
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined align-middle me-1">save</span>
            Lưu
        </button>
        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
