@model Webpcvaphukienkethopchatbot.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Create product" : "Edit product";
}

<h1 class="h3 mb-3">@(Model.Id == 0 ? "Them san pham" : "Sua san pham")</h1>

<form asp-action="Save" method="post" enctype="multipart/form-data" class="border rounded p-3">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImageUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Name" class="form-label">Ten san pham</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Price" class="form-label">Gia</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="StockQuantity" class="form-label">Ton kho</label>
            <input asp-for="StockQuantity" class="form-control" />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CategoryId" class="form-label">Danh muc</label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BrandId" class="form-label">Thuong hieu</label>
            <select asp-for="BrandId" asp-items="Model.Brands" class="form-select"></select>
            <span asp-validation-for="BrandId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Cpu" class="form-label">CPU</label>
            <input asp-for="Cpu" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Ram" class="form-label">RAM</label>
            <input asp-for="Ram" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Ssd" class="form-label">SSD</label>
            <input asp-for="Ssd" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Gpu" class="form-label">GPU</label>
            <input asp-for="Gpu" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Screen" class="form-label">Man hinh</label>
            <input asp-for="Screen" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Battery" class="form-label">Pin</label>
            <input asp-for="Battery" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Weight" class="form-label">Trong luong</label>
            <input asp-for="Weight" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="OperatingSystem" class="form-label">He dieu hanh</label>
            <input asp-for="OperatingSystem" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="SuitableNeeds" class="form-label">Nhu cau phu hop</label>
            <input asp-for="SuitableNeeds" class="form-control" />
            <span asp-validation-for="SuitableNeeds" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="ImageFile" class="form-label">Anh san pham</label>
            <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif,.svg" />
        </div>
        <div class="col-md-4">
            @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
            {
                <img src="@Model.ExistingImageUrl" alt="@Model.Name" class="img-fluid border rounded p-2" />
            }
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Mo ta</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Hien thi san pham</label>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Luu</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Huy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
