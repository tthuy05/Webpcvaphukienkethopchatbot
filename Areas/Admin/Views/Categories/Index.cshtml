@model IReadOnlyList<Webpcvaphukienkethopchatbot.ViewModels.CatalogItemViewModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Danh muc</h1>
    <a class="btn btn-primary" asp-action="Create">Them danh muc</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Ten</th>
                <th>Slug</th>
                <th>San pham</th>
                <th>Trang thai</th>
                <th class="text-end">Thao tac</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Slug</td>
                <td>@item.ProductCount</td>
                <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Hien" : "An")</span></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sua</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">An/Xoa</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
