@using Webpcvaphukienkethopchatbot.Services
@using Webpcvaphukienkethopchatbot.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@using Webpcvaphukienkethopchatbot.Resources
@inject IProductService ProductService
@inject IHtmlLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Trang chủ"].Value;
    var featuredModel = await ProductService.SearchAsync(new ProductFilterViewModel { SortBy = "best-selling" }, Context.RequestAborted);
    var featuredProducts = featuredModel.Products.Take(3).ToList();
}

<section class="hero-grid">
    <div>
        <div class="section-kicker">@Localizer["AI powered PC store"]</div>
        <h1 class="hero-title">@Localizer["Tự build bộ máy đúng nhu cầu với"] <span>@Localizer["Tư vấn AI"]</span>.</h1>
        <p class="hero-copy">
            @Localizer["Tìm laptop, PC và phụ kiện theo ngân sách, cấu hình, mục đích học tập, làm việc hoặc gaming. Chatbot sẽ gợi ý nhanh những lựa chọn phù hợp nhất."]
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary" asp-controller="Chatbot" asp-action="Index">
                <span class="material-symbols-outlined align-middle me-1">psychology</span>
                @Localizer["Hỏi AI tư vấn"]
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Index">
                <span class="material-symbols-outlined align-middle me-1">grid_view</span>
                @Localizer["Xem sản phẩm"]
            </a>
        </div>
        <div class="chip-row mt-4">
            <span class="chip">@Localizer["Laptop văn phòng"]</span>
            <span class="chip">@Localizer["PC gaming"]</span>
            <span class="chip">@Localizer["Đồ họa - render"]</span>
            <span class="chip">@Localizer["Phụ kiện setup"]</span>
        </div>
    </div>
    <div class="hero-media" aria-label="@Localizer["Laptop và phụ kiện công nghệ"]">
        <img src="~/images/products/placeholder-laptop.svg" asp-append-version="true" alt="@Localizer["Laptop và phụ kiện công nghệ"]" />
    </div>
</section>

<section class="surface-panel mb-5">
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-end mb-4">
        <div>
            <div class="section-kicker">@Localizer["Danh mục nổi bật"]</div>
            <h2 class="h3 fw-bold mb-0">@Localizer["Mua nhanh theo nhu cầu"]</h2>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Products" asp-action="Index">@Localizer["Tất cả sản phẩm"]</a>
    </div>
    <div class="category-grid">
        <a class="category-tile" asp-controller="Products" asp-action="Index" asp-route-UsageNeed="hoc tap">
            <span class="material-symbols-outlined">school</span>
            <strong>@Localizer["Học tập"]</strong>
            <small>@Localizer["Laptop gọn nhẹ, pin tốt"]</small>
        </a>
        <a class="category-tile" asp-controller="Products" asp-action="Index" asp-route-UsageNeed="gaming">
            <span class="material-symbols-outlined">sports_esports</span>
            <strong>Gaming</strong>
            <small>@Localizer["GPU mạnh, tản nhiệt ổn định"]</small>
        </a>
        <a class="category-tile" asp-controller="Products" asp-action="Index" asp-route-UsageNeed="do hoa">
            <span class="material-symbols-outlined">architecture</span>
            <strong>@Localizer["Đồ họa"]</strong>
            <small>@Localizer["Màn hình đẹp, RAM cao"]</small>
        </a>
        <a class="category-tile" asp-controller="Products" asp-action="Index">
            <span class="material-symbols-outlined">keyboard</span>
            <strong>@Localizer["Phụ kiện"]</strong>
            <small>@Localizer["Hoàn thiện góc làm việc"]</small>
        </a>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-end mb-4">
        <div>
            <div class="section-kicker">@Localizer["Sản phẩm gợi ý"]</div>
            <h2 class="h3 fw-bold mb-0">@Localizer["Lựa chọn phù hợp mỗi ngày"]</h2>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="Chatbot" asp-action="Index">@Localizer["Nhận gợi ý riêng"]</a>
    </div>
    @if (featuredProducts.Any())
    {
        <div class="product-grid">
            @foreach (var product in featuredProducts)
            {
                <article class="tech-card product-card">
                    <a class="product-card-media" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                        <img src="@product.MainImageUrl" alt="@product.Name" />
                    </a>
                    <div class="product-card-body">
                        <div class="chip-row mb-3">
                            <span class="chip">@product.BrandName</span>
                            <span class="chip">@product.CategoryName</span>
                        </div>
                        <h3 class="h5 fw-bold">
                            <a class="text-reset text-decoration-none" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                        </h3>
                        <p class="muted-text mb-3">@product.SuitableNeeds</p>
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-auto">
                            <div>
                                <div class="price-text">@product.Price.ToString("N0") VND</div>
                                <div class="small @(product.StockQuantity > 0 ? "text-success" : "text-danger")">
                                    @(product.StockQuantity > 0 ? Localizer["Còn {0} sản phẩm", product.StockQuantity] : Localizer["Hết hàng"])
                                </div>
                            </div>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@Localizer["Chi tiết"]</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="surface-panel text-center">
            <span class="material-symbols-outlined empty-icon">inventory_2</span>
            <h3 class="h5 fw-bold mt-3">@Localizer["Chưa có sản phẩm hiển thị"]</h3>
            <p class="muted-text mb-4">@Localizer["Hãy thêm sản phẩm trong khu vực admin để các card trên trang chủ tự động lấy dữ liệu thật."]</p>
            <a class="btn btn-primary" asp-controller="Products" asp-action="Index">@Localizer["Mở catalog"]</a>
        </div>
    }
</section>

<section class="feature-band">
    <div>
        <div class="section-kicker">@Localizer["Chatbot tư vấn"]</div>
        <h2 class="h3 fw-bold mb-3">@Localizer["Nói ngân sách và mục đích, hệ thống sẽ lọc sản phẩm phù hợp."]</h2>
        <p class="muted-text mb-0">@Localizer["HomeChatbotExamples"]</p>
    </div>
    <a class="btn btn-primary" asp-controller="Chatbot" asp-action="Index">
        <span class="material-symbols-outlined align-middle me-1">smart_toy</span>
        @Localizer["Bắt đầu tư vấn"]
    </a>
</section>

<a class="floating-chat" asp-controller="Chatbot" asp-action="Index" title="@Localizer["Chatbot AI"]">
    <span class="material-symbols-outlined">chat</span>
</a>
