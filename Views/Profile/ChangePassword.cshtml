@model Webpcvaphukienkethopchatbot.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<header class="page-header">
    <div>
        <p class="page-kicker">Bảo mật tài khoản</p>
        <h1 class="page-title">Đổi mật khẩu</h1>
        <p class="page-subtitle">Cập nhật mật khẩu định kỳ để tăng độ an toàn cho tài khoản.</p>
    </div>
</header>

<nav class="account-nav" aria-label="Điều hướng tài khoản">
    <a class="account-nav-link" asp-action="Index">Thông tin cá nhân</a>
    <a class="account-nav-link active" aria-current="page" asp-action="ChangePassword">Đổi mật khẩu</a>
    <a class="account-nav-link" asp-action="TwoFactor">Xác thực hai bước</a>
    <a class="account-nav-link" asp-action="VerifyPhone">Xác nhận số điện thoại</a>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <section class="surface-card" aria-labelledby="change-password-form-title">
            <div class="surface-card-header">
                <div>
                    <h2 id="change-password-form-title" class="h5 mb-1">Thiết lập mật khẩu mới</h2>
                    <p class="text-muted mb-0">Nhập mật khẩu hiện tại để xác nhận thay đổi.</p>
                </div>
            </div>
            <div class="surface-card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="form-section">
                        <div>
                            <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                            <input asp-for="CurrentPassword"
                                   class="form-control"
                                   autocomplete="current-password"
                                   autofocus
                                   placeholder="Nhập mật khẩu hiện tại" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div>
                            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Nhập mật khẩu mới" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div>
                            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Nhập lại mật khẩu mới" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <p class="form-text mb-0">
                            Mật khẩu cần có ít nhất 8 ký tự và đáp ứng các yêu cầu bảo mật của hệ thống.
                        </p>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" type="submit">Cập nhật mật khẩu</button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
