@model Webpcvaphukienkethopchatbot.ViewModels.ProfileViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Webpcvaphukienkethopchatbot.Models.Enums
@using Webpcvaphukienkethopchatbot.Resources
@inject IHtmlLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Profile"].Value;
}

@functions {
    private static string StatusClass(OrderStatus status) => status switch
    {
        OrderStatus.Completed => "state-badge--success",
        OrderStatus.Cancelled => "state-badge--danger",
        OrderStatus.Shipping => "state-badge--info",
        OrderStatus.Confirmed => "state-badge--warning",
        _ => "state-badge--neutral"
    };
}

<section class="page-heading">
    <div>
        <nav class="breadcrumb-line" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">@Localizer["Trang chủ"]</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>@Localizer["Profile"]</span>
        </nav>
        <div class="section-kicker">@Localizer["Account center"]</div>
        <h1 class="hero-title hero-title--page">@Localizer["Thông tin cá nhân"]</h1>
        <p class="hero-copy">@Localizer["Cập nhật thông tin nhận hàng để checkout nhanh hơn trong các lần mua tiếp theo."]</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Orders" asp-action="Index">
        <span class="material-symbols-outlined align-middle me-1">receipt_long</span>
        @Localizer["Đơn hàng"]
    </a>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="profile-grid">
    <section class="form-card">
        <div class="form-section-title">
            <span class="material-symbols-outlined">manage_accounts</span>
            <span>@Localizer["Hồ sơ giao hàng"]</span>
        </div>
        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label">@Localizer["Họ tên"]</label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">@Localizer["Số điện thoại"]</label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Address" class="form-label">@Localizer["Địa chỉ"]</label>
                <textarea asp-for="Address" class="form-control" rows="4" autocomplete="street-address"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">
                <span class="material-symbols-outlined align-middle me-1">save</span>
                @Localizer["Cập nhật"]
            </button>
        </form>
    </section>

    <section class="data-panel">
        <div class="data-panel__header">
            <div>
                <div class="section-kicker">@Localizer["Gần đây"]</div>
                <h2 class="h4 fw-bold mb-0">@Localizer["Đơn hàng gần đây"]</h2>
            </div>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Orders" asp-action="Index">@Localizer["Xem tất cả"]</a>
        </div>

        @if (!Model.RecentOrders.Any())
        {
            <div class="empty-state">
                <span class="material-symbols-outlined empty-icon">shopping_bag</span>
                <h3 class="h5 fw-bold mb-0">@Localizer["Chưa có đơn hàng"]</h3>
                <p class="muted-text mb-0">@Localizer["Các đơn hàng mới sẽ xuất hiện ở đây sau khi bạn checkout thành công."]</p>
            </div>
        }
        else
        {
            <div class="table-shell">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Mã đơn"]</th>
                            <th>@Localizer["Ngày tạo"]</th>
                            <th>@Localizer["Trạng thái"]</th>
                            <th class="text-end">@Localizer["Tổng tiền"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td><span class="state-badge @StatusClass(order.Status)">@order.Status</span></td>
                            <td class="text-end fw-bold">@order.TotalAmount.ToString("N0") VND</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
