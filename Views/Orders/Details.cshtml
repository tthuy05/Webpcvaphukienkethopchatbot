@model Webpcvaphukienkethopchatbot.ViewModels.OrderDetailViewModel

@{
    ViewData["Title"] = Model.OrderNumber;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Don hang @Model.OrderNumber</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Lich su don hang</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="border rounded p-3">
            <h2 class="h5">Nguoi nhan</h2>
            <div>@Model.ReceiverName</div>
            <div>@Model.PhoneNumber</div>
            <div>@Model.ShippingAddress</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="border rounded p-3">
            <h2 class="h5">Trang thai</h2>
            <div>Don hang: @Model.Status</div>
            <div>Thanh toan: @Model.PaymentStatus</div>
            <div>Phuong thuc: @Model.PaymentMethod</div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>San pham</th>
                <th class="text-end">Don gia</th>
                <th class="text-end">So luong</th>
                <th class="text-end">Thanh tien</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td class="text-end">@item.UnitPrice.ToString("N0")</td>
                <td class="text-end">@item.Quantity</td>
                <td class="text-end">@item.LineTotal.ToString("N0")</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Tong tien</th>
                <th class="text-end">@Model.TotalAmount.ToString("N0")</th>
            </tr>
        </tfoot>
    </table>
</div>
