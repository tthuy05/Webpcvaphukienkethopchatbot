@using Webpcvaphukienkethopchatbot.Models.Enums
@model Webpcvaphukienkethopchatbot.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<h1 class="h3 mb-3">Thanh toan</h1>

@if (!Model.Cart.Items.Any())
{
    <div class="alert alert-info">Gio hang dang trong.</div>
    <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Tiep tuc mua sam</a>
}
else
{
    <form asp-action="Checkout" method="post" class="row g-4">
        <div class="col-lg-6">
            <div class="border rounded p-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="ReceiverName" class="form-label">Nguoi nhan</label>
                    <input asp-for="ReceiverName" class="form-control" />
                    <span asp-validation-for="ReceiverName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">So dien thoai</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ShippingAddress" class="form-label">Dia chi giao hang</label>
                    <textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PaymentMethod" class="form-label">Phuong thuc thanh toan</label>
                    <select asp-for="PaymentMethod" class="form-select">
                        <option value="@PaymentMethod.CashOnDelivery">Thanh toan khi nhan hang</option>
                        <option value="@PaymentMethod.SimulatedBankTransfer">Chuyen khoan gia lap</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Dat hang</button>
                <a class="btn btn-outline-secondary" asp-controller="Cart" asp-action="Index">Quay lai gio hang</a>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="border rounded p-3">
                <h2 class="h5">Tom tat don hang</h2>
                @foreach (var item in Model.Cart.Items)
                {
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span>@item.ProductName x @item.Quantity</span>
                        <span>@item.LineTotal.ToString("N0")</span>
                    </div>
                }
                <div class="d-flex justify-content-between fw-bold pt-3">
                    <span>Tong tien</span>
                    <span>@Model.Cart.Total.ToString("N0")</span>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
