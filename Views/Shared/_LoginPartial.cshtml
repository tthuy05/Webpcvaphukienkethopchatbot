@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.Localization
@using Webpcvaphukienkethopchatbot.Models
@using Webpcvaphukienkethopchatbot.Resources
@inject IHtmlLocalizer<SharedResource> Localizer
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Admin"))
    {
        <a class="icon-action" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" title="@Localizer["Admin"]">
            <span class="material-symbols-outlined">dashboard</span>
        </a>
    }
    <a class="icon-action" asp-area="" asp-controller="Profile" asp-action="Index" title="@Localizer["Profile"]">
        <span class="material-symbols-outlined">account_circle</span>
    </a>
    <form class="app-action-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="icon-action" title="@Localizer["Logout"]">
            <span class="material-symbols-outlined">logout</span>
        </button>
    </form>
}
else
{
    <a class="auth-pill auth-pill--premium" asp-area="Identity" asp-page="/Account/Login">
        <span class="material-symbols-outlined">login</span>
        <span>@Localizer["Login"]</span>
    </a>
    <a class="icon-action d-none d-md-inline-flex" asp-area="Identity" asp-page="/Account/Register" title="@Localizer["Register"]">
        <span class="material-symbols-outlined">person_add</span>
    </a>
}
