@using Microsoft.AspNetCore.Identity
@using Webpcvaphukienkethopchatbot.Models
@inject SignInManager<ApplicationUser> SignInManager

@{
    var displayName = User.Identity?.Name ?? "Tài khoản";
    var initial = string.IsNullOrWhiteSpace(displayName)
        ? "U"
        : displayName.Trim()[0].ToString().ToUpperInvariant();
}

<div class="app-header-actions">
    @if (SignInManager.IsSignedIn(User))
    {
        <a class="user-chip"
           asp-area=""
           asp-controller="Profile"
           asp-action="Index"
           title="Mở hồ sơ cá nhân">
            <span class="user-avatar" aria-hidden="true">@initial</span>
            <span class="user-chip-copy">
                <small>Tài khoản</small>
                <strong>@displayName</strong>
            </span>
        </a>
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="app-logout-form">
            <button type="submit" class="btn btn-ghost btn-sm">Đăng xuất</button>
        </form>
    }
    else
    {
        <a class="btn btn-ghost btn-sm d-none d-sm-inline-flex"
           asp-area=""
           asp-controller="Account"
           asp-action="Register">Đăng ký</a>
        <a class="btn btn-primary btn-sm"
           asp-area=""
           asp-controller="Account"
           asp-action="Login">Đăng nhập</a>
    }
</div>
