@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<header class="page-header">
    <div>
        <p class="page-kicker">Thông báo hệ thống</p>
        <span class="status-badge status-danger mb-3">Không thể xử lý yêu cầu</span>
        <h1 class="page-title">Đã xảy ra lỗi</h1>
        <p class="page-subtitle">
            Hệ thống gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại sau.
        </p>
    </div>
</header>

<section class="surface-card" aria-labelledby="error-details-title">
    <div class="surface-card-header">
        <h2 id="error-details-title" class="h5 mb-0">Thông tin chẩn đoán</h2>
    </div>
    <div class="surface-card-body">
        @if (Model.ShowRequestId)
        {
            <p>
                <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <h3 class="h6">Chế độ phát triển</h3>
        <p>
            Chuyển ứng dụng sang môi trường <strong>Development</strong> sẽ hiển thị thông tin chi tiết hơn
            về lỗi đã xảy ra.
        </p>
        <p class="mb-0">
            <strong>Không nên bật môi trường Development trên hệ thống đang triển khai.</strong>
            Chế độ này có thể làm lộ thông tin nhạy cảm từ ngoại lệ cho người dùng cuối.
            Khi gỡ lỗi cục bộ, đặt biến môi trường <strong>ASPNETCORE_ENVIRONMENT</strong> thành
            <strong>Development</strong> rồi khởi động lại ứng dụng.
        </p>
    </div>
</section>
