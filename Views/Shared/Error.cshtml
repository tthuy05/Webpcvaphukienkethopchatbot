@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="surface-panel empty-state">
    <span class="material-symbols-outlined empty-icon">error</span>
    <div>
        <div class="section-kicker">Application error</div>
        <h1 class="hero-title hero-title--page mb-3">Không thể xử lý yêu cầu</h1>
        <p class="hero-copy mx-auto mb-0">Đã có lỗi xảy ra trong quá trình xử lý. Hãy thử tải lại trang hoặc quay về trang chủ.</p>
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="muted-text mb-0">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <div class="button-row justify-content-center mt-0">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
        <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Index">Xem sản phẩm</a>
    </div>
</section>
