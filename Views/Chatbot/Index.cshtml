@model Webpcvaphukienkethopchatbot.ViewModels.ChatbotResponseViewModel?

@{
    ViewData["Title"] = "Chatbot";
}

<h1 class="h3 mb-3">Chatbot tu van san pham</h1>

<form asp-action="Index" method="post" class="border rounded p-3 mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label for="question" class="form-label">Cau hoi</label>
        <textarea id="question" name="question" rows="3" class="form-control">@Model?.Question</textarea>
    </div>
    <button type="submit" class="btn btn-primary">Gui</button>
</form>

@if (Model is not null)
{
    <div class="border rounded p-3 mb-4">
        <h2 class="h5">Phan tich</h2>
        <div>Ngan sach: @(Model.DetectedBudget.HasValue ? Model.DetectedBudget.Value.ToString("N0") : "Chua ro")</div>
        <div>Nhu cau: @(Model.DetectedUsageNeed ?? "Chua ro")</div>
        <p class="mt-3 mb-0">@Model.Answer</p>
    </div>

    @if (Model.Suggestions.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-3">
            @foreach (var item in Model.Suggestions)
            {
                <div class="col">
                    <div class="border rounded h-100 p-3">
                        <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid mb-3 product-card-image" />
                        <h3 class="h5">@item.ProductName</h3>
                        <div class="fw-bold">@item.Price.ToString("N0") VND</div>
                        <p class="small mt-2">@item.Reason</p>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">Xem san pham</a>
                    </div>
                </div>
            }
        </div>
    }
}
