@model Webpcvaphukienkethopchatbot.ViewModels.ChatbotViewModel
@{
    ViewData["Title"] = "Tư vấn sản phẩm";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-9">
        <header class="page-header">
            <div>
                <div class="page-kicker">Tư vấn theo nhu cầu</div>
                <h1 class="page-title">Trợ lý tư vấn sản phẩm AI</h1>
                <p class="page-subtitle">Ví dụ: “Laptop lập trình dưới 20 triệu” hoặc “Bàn phím cơ giá rẻ”.</p>
            </div>
        </header>

        <form method="post" class="toolbar-card pc-filter-panel mb-4 border-0 p-4 bg-white">
            <div class="mb-3">
                <label asp-for="Question" class="form-label fw-semibold text-secondary">Tôi có thể giúp gì cho bạn hôm nay?</label>
                <div class="input-group">
                    <input asp-for="Question" class="form-control" autofocus placeholder="Nhập nhu cầu tìm kiếm của bạn..." style="height: 48px;" />
                    <button class="btn btn-primary d-flex align-items-center gap-2 px-4" style="height: 48px;">
                        <svg aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                        Tư vấn ngay
                    </button>
                </div>
                <span asp-validation-for="Question" class="text-danger small mt-1 d-block"></span>
            </div>
        </form>

        @if (Model.Answer is not null)
        {
            <section class="surface-card alert alert-info border-0 shadow-sm rounded-3 mb-4 p-4 d-flex gap-3" aria-labelledby="chatbot-answer-title">
                <div class="text-primary mt-1">
                    <svg aria-hidden="true" focusable="false" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                </div>
                <div>
                    <h2 id="chatbot-answer-title" class="section-heading h6 fw-bold text-dark mb-2">Câu trả lời tư vấn</h2>
                    <p class="mb-0 text-secondary" style="font-size: 0.95rem; line-height: 1.6;">@Model.Answer</p>
                </div>
            </section>

            @if (Model.Recommendations != null && Model.Recommendations.Any())
            {
                <h2 class="section-heading h5 fw-bold mb-3">Sản phẩm gợi ý cho bạn</h2>
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    @foreach (var product in Model.Recommendations)
                    {
                        <div class="col">
                            <article class="product-card card h-100 pc-card border-0" style="transform: none; box-shadow: var(--shadow-subtle);">
                                <div class="product-card-body card-body p-4 d-flex flex-column justify-content-between">
                                    <div>
                                        <h3 class="h6 mb-2">
                                            <a class="text-decoration-none text-dark fw-bold" asp-controller="Products" asp-action="Details" asp-route-slug="@product.Slug">@product.Name</a>
                                        </h3>
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="price text-danger fw-bold">@product.CurrentPrice.ToString("N0") ₫</span>
                                            <span class="status-badge @(product.StockQuantity > 0 ? "status-success" : "status-muted") pc-badge @(product.StockQuantity > 0 ? "pc-badge-success" : "pc-badge-secondary")">
                                                @(product.StockQuantity > 0 ? $"Còn {product.StockQuantity}" : "Hết hàng")
                                            </span>
                                        </div>
                                        <p class="text-muted small pc-clamp-3 mb-0">@product.Description</p>
                                    </div>
                                    <div class="mt-3">
                                        <a class="btn btn-sm btn-outline-secondary w-100" asp-controller="Products" asp-action="Details" asp-route-slug="@product.Slug">Xem chi tiết</a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
