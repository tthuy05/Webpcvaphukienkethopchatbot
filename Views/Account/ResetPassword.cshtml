@model Webpcvaphukienkethopchatbot.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-shell">
    <section class="auth-card" aria-labelledby="reset-password-title">
        <div class="auth-brand-mark" aria-hidden="true">PC</div>
        <p class="page-kicker">Khôi phục tài khoản</p>
        <h1 id="reset-password-title" class="page-title">Đặt lại mật khẩu</h1>
        <p class="page-subtitle">Tạo mật khẩu mới để tiếp tục sử dụng tài khoản của bạn.</p>

        <form method="post">
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-section">
                <div>
                    <label asp-for="Password" class="form-label">Mật khẩu mới</label>
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="new-password"
                           autofocus
                           placeholder="Nhập mật khẩu mới" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Nhập lại mật khẩu mới" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <p class="form-text mb-0">
                    Mật khẩu cần có ít nhất 8 ký tự và đáp ứng các yêu cầu bảo mật của hệ thống.
                </p>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary w-100" type="submit">Cập nhật mật khẩu</button>
            </div>
        </form>
    </section>

    <aside class="auth-aside" aria-label="Lưu ý về mật khẩu mới">
        <p class="page-kicker">Bảo mật tài khoản</p>
        <h2>Chọn mật khẩu mạnh và chỉ dùng cho tài khoản này</h2>
        <p>
            Kết hợp chữ hoa, chữ thường, chữ số và ký tự đặc biệt để tăng độ an toàn.
        </p>
    </aside>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
