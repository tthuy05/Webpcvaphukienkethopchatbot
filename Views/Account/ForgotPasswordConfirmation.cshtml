@{
    ViewData["Title"] = "Kiểm tra email";
}

<div class="auth-shell">
    <section class="auth-card" aria-labelledby="forgot-confirmation-title">
        <div class="auth-brand-mark" aria-hidden="true">PC</div>
        <p class="page-kicker">Khôi phục tài khoản</p>
        <span class="status-badge status-info mb-3">Yêu cầu đã được tiếp nhận</span>
        <h1 id="forgot-confirmation-title" class="page-title">Kiểm tra hộp thư của bạn</h1>
        <p class="page-subtitle">
            Nếu email tồn tại trong hệ thống, liên kết đặt lại mật khẩu đã được tạo.
        </p>

        @if (ViewBag.ActionUrl is string actionUrl)
        {
            <div class="alert alert-info" role="status">
                <strong>Chế độ demo:</strong> sử dụng liên kết dưới đây để tiếp tục.
            </div>
            <div class="form-actions">
                <a class="btn btn-primary" href="@actionUrl">Đặt lại mật khẩu demo</a>
            </div>
        }
    </section>

    <aside class="auth-aside" aria-label="Lưu ý khi đặt lại mật khẩu">
        <p class="page-kicker">Lưu ý bảo mật</p>
        <h2>Chỉ sử dụng liên kết được tạo cho yêu cầu của bạn</h2>
        <p>
            Liên kết đặt lại mật khẩu có thể hết hiệu lực và không nên được chia sẻ với người khác.
        </p>
    </aside>
</div>
