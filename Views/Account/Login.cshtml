@model Webpcvaphukienkethopchatbot.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-shell">
    <section class="auth-card" aria-labelledby="login-title">
        <div class="auth-brand-mark" aria-hidden="true">PC</div>
        <p class="page-kicker">Chào mừng trở lại</p>
        <h1 id="login-title" class="page-title">Đăng nhập tài khoản</h1>
        <p class="page-subtitle">Tiếp tục quản lý giỏ hàng, đơn hàng và sản phẩm yêu thích của bạn.</p>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="status" aria-live="polite">
                @successMessage
            </div>
        }

        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-section">
                <div>
                    <label asp-for="Email" class="form-label">Email đăng nhập</label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="email"
                           inputmode="email"
                           autofocus
                           placeholder="email@vidu.vn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div>
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <label asp-for="Password" class="form-label mb-0">Mật khẩu</label>
                        <a asp-action="ForgotPassword" class="btn-link small">Quên mật khẩu?</a>
                    </div>
                    <input asp-for="Password"
                           class="form-control mt-2"
                           autocomplete="current-password"
                           placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                </div>
            </div>

            <div class="surface-card mt-4">
                <div class="surface-card-body">
                    <label asp-for="CaptchaAnswer" class="form-label">Xác minh bảo mật: @Model.CaptchaQuestion</label>
                    <input asp-for="CaptchaAnswer"
                           class="form-control"
                           inputmode="numeric"
                           autocomplete="off"
                           placeholder="Nhập kết quả phép tính" />
                    <span asp-validation-for="CaptchaAnswer" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
            </div>
        </form>

        <p class="mt-4 mb-0 text-center text-muted">
            Chưa có tài khoản? <a asp-action="Register" class="btn-link fw-semibold">Đăng ký ngay</a>
        </p>
    </section>

    <aside class="auth-aside" aria-label="Lợi ích tài khoản">
        <p class="page-kicker">Tài khoản PC Store</p>
        <h2>Mọi thông tin mua sắm trong một nơi</h2>
        <p>
            Theo dõi trạng thái đơn hàng, lưu danh sách yêu thích và quản lý các thiết lập bảo mật.
        </p>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
