@model Webpcvaphukienkethopchatbot.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-shell">
    <section class="auth-card" aria-labelledby="forgot-password-title">
        <div class="auth-brand-mark" aria-hidden="true">PC</div>
        <p class="page-kicker">Khôi phục tài khoản</p>
        <h1 id="forgot-password-title" class="page-title">Quên mật khẩu?</h1>
        <p class="page-subtitle">Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-section">
                <div>
                    <label asp-for="Email" class="form-label">Địa chỉ email</label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="email"
                           inputmode="email"
                           autofocus
                           placeholder="email@vidu.vn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary w-100" type="submit">Gửi liên kết đặt lại mật khẩu</button>
            </div>
        </form>
    </section>

    <aside class="auth-aside" aria-label="Hướng dẫn khôi phục mật khẩu">
        <p class="page-kicker">Khôi phục an toàn</p>
        <h2>Chúng tôi không tiết lộ tài khoản có tồn tại hay không</h2>
        <p>
            Sau khi gửi yêu cầu, hãy kiểm tra hộp thư của bạn để tiếp tục nếu email hợp lệ.
        </p>
    </aside>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
